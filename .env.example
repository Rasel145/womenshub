# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# The website connects with this LIMITED database user
DATABASE_URL="postgresql://womenshub_app:CHANGE_ME@localhost:5432/womenshub?schema=public"

# Only used by Prisma commands (migrate, studio): the database owner
MIGRATE_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/womenshub?schema=public"

# Long random text (at least 32 characters), used by the scheduler
CRON_SECRET="CHANGE_ME"

# Cloudflare Turnstile. The values below are TEST keys and are refused on the live site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"