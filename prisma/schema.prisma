generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
}

enum DeliveryArea {
  DHAKA
  OUTSIDE
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
  sessions     Session[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  price       Int
  oldPrice    Int?
  rating      Float       @default(0)
  reviewCount Int         @default(0)
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  variants    String[]
  categoryId  String
  images      String[]    @default([])
  brandId     String
  category    Category    @relation(fields: [categoryId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  name          String
  phone         String
  address       String
  city          String
  note          String?
  area          DeliveryArea
  paymentMethod PaymentMethod
  subtotal      Int
  deliveryFee   Int
  total         Int
  status        OrderStatus   @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  variant     String?
  unitPrice   Int
  quantity    Int
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}