generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
}

enum DeliveryArea {
  DHAKA
  OUTSIDE
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
  sessions     Session[]
  passwordResets PasswordReset[]
  wishlist       WishlistItem[]
  reviews        Review[]
  auditLogs      AuditLog[]
  gender         String?
  dateOfBirth    DateTime? @db.Date
  avatarUrl      String?

}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  position Int       @default(0)
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  price       Int
  oldPrice    Int?
  rating      Float       @default(0)
  reviewCount Int         @default(0)
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  variants    String[]
  categoryId  String
  images      String[]    @default([])
  brandId     String
  category    Category    @relation(fields: [categoryId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  wishlistedBy WishlistItem[]
  reviews      Review[]
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  name          String
  phone         String
  address       String
  city          String
  note          String?
  area          DeliveryArea
  paymentMethod PaymentMethod
  subtotal      Int
  deliveryFee   Int
  total         Int
  status        OrderStatus   @default(PENDING)
  items         OrderItem[]
  courier       String?
  trackingCode  String?
  consignmentId String?
  adminNote     String?
  adminSeenAt   DateTime?
  events        OrderEvent[]
  createdAt     DateTime      @default(now())

}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  variant     String?
  unitPrice   Int
  quantity    Int
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isVisible, createdAt])
}
model RateLimit {
  key     String @id
  count   Int
  resetAt BigInt // when this counting window ends, in milliseconds
}

model OrderEvent {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            OrderStatus?
  message           String
  location          String?
  visibleToCustomer Boolean      @default(true)
  createdById       String?
  createdAt         DateTime     @default(now())

  @@index([orderId, createdAt])
}

model BlockedPhone {
  id          String   @id @default(cuid())
  phone       String   @unique
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}